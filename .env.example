# =============================================================================
# Quant Lab — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed and
# must never contain real secrets.
#
#     cp .env.example .env
#
# Defaults shown for non-secret values match the code's fallbacks, so you only
# strictly need to set the ones marked REQUIRED.
# =============================================================================

# --- TimescaleDB (financials: OHLCV, features, registries) -------------------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=quantlab
TIMESCALE_USER=quant
TIMESCALE_PASSWORD=                      # REQUIRED
# Optional: overrides the assembled URL above if set.
# DATABASE_URL=postgresql+psycopg2://quant:PASSWORD@timescaledb:5432/quantlab

# --- Alt-data PostgreSQL (flights) — separate container, host port 5433 ------
ALT_DB_HOST=alt-postgres
ALT_DB_PORT=5432
ALT_DB_NAME=alt_data
ALT_DB_USER=alt_user
ALT_DB_PASSWORD=                         # REQUIRED
ALT_DB_SCHEMA=public

# --- Market data providers ---------------------------------------------------
# Twelve Data — the source behind the 1-minute feature store. Free tier is
# rate-limited; the client caps itself at 7 req/min.
TD_API_KEY=                              # REQUIRED for 1-min ingestion

# Alpha Vantage — currently READ BUT UNUSED. financials/data_pipeline/
# ingestion.py loads it into `av_key` and never calls it. Leave blank unless
# you wire the provider up (free tier is 25 req/day).
AV_API_KEY=

# yfinance needs no credentials.

# --- OpenSky Network (alt-data flight tracking) ------------------------------
# Leave both blank to run anonymously (much lower rate limits).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_RPM=30                           # client-side sliding-window limit
OPENSKY_TIMEOUT=30                       # per-request seconds
OPENSKY_TOKEN_REFRESH_MARGIN=30          # refresh token this many s before expiry
OPENSKY_MAX_RETRY_AFTER=300              # Retry-After above this => quota error, abort

# --- JupyterLab --------------------------------------------------------------
# Both notebook services (8889 plain, 8888 torch+CUDA) share this token.
JUPYTER_TOKEN=                           # REQUIRED

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
